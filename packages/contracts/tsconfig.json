{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "types": [
      "node",
      "mocha",
      "chai",
      "hardhat"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "hardhat.config.cjs",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ]
}