{
  "name": "trustify",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm --filter @trustify/web dev",
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "contracts:deploy:localhost": "pnpm --filter @trustify/contracts deploy:localhost",
    "contracts:deploy:amoy": "pnpm --filter @trustify/contracts deploy:amoy",
    "contracts:verify:amoy": "pnpm --filter @trustify/contracts verify:amoy",
    "contracts:export": "pnpm --filter @trustify/contracts export:abis"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "pino-pretty": "^13.1.3"
  }
}
